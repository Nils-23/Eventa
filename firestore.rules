rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is user signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if authenticated user is admin in users collection
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users
    // Owners edit their own doc, but creator status is admin-granted only:
    // without the field guard, anyone could self-assign accountType='creator'.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['accountType', 'creator'])
      );
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'creator'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Venues
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Creators (Affiliates)
    match /creators/{creatorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Installs (Audits Log)
    // Locked down to client-side writes. Created/validated strictly via Cloud Functions.
    match /installs/{installId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    // Pending Clicks (Attribution logs)
    // Only accessible/readable by admin for dashboard simulation.
    match /pending_clicks/{clickId} {
      allow read, write: if isAdmin();
    }

    // Stories
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Settings (e.g. simulation settings)
    match /settings/{settingId} {
      allow read: if isAuthenticated() || settingId == 'app_config';
      allow write: if isAdmin();
    }

    // Platform Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() 
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Recurring Stories
    match /recurring_stories/{scheduleId} {
      allow read, write: if isAdmin();
    }

    // Pending Events (Claude Event Curator staging area)
    match /pendingEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    // ── Creator Program ──────────────────────────────────────────────────

    // Applications. Full Name is PRIVATE: readable only by the applicant and
    // admins. Owners can never change `status` — approval/rejection is
    // admin-only. Owners may update a pending application (code regeneration)
    // and re-apply after a rejection.
    match /creatorApplications/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && (resource.data.status == 'pending' || resource.data.status == 'rejected')
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Event attendance ("I'm Going"). Visible to everyone in the app; only an
    // approved creator can declare their own attendance. Geofence verification
    // updates the creator's own doc.
    match /creatorAttendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'creator';
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }

    // ── Saved events ("remind me") ────────────────────────────────────────
    // Strictly private, unlike creatorAttendance: a saved event is nobody
    // else's business, so read is owner-only rather than app-wide. This is
    // also what guarantees a reminder reaches only the user who asked for it.
    //
    // The remindedDayBefore / remindedDayOf flags are server-owned. A create
    // must start with both false and clients can never update the doc, so a
    // user can neither replay a reminder nor silence one by pre-marking it
    // sent; the scheduled function writes them through the Admin SDK, which
    // bypasses these rules.
    match /savedEvents/{savedEventId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.remindedDayBefore == false
        && request.resource.data.remindedDayOf == false;
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow update: if isAdmin();
    }

    // Visits — the GPS-verified ledger that gates reviews.
    // Written by the client when the user is inside the venue radius, so the id
    // is derived (uid_day_venue) and the rule pins the owner: a user can only
    // ever write their own visit, and only under their own id.
    match /visits/{visitId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && visitId == request.auth.uid + '_' + request.resource.data.dayKey + '_' + request.resource.data.venueId;
      allow delete: if isAdmin();
    }

    // Reviews.
    //
    // Readable by everyone — they are the point. Writes are pinned three ways:
    //   1. The doc id must be uid_venueId, so one person holds exactly one
    //      review per venue and editing replaces rather than stacks.
    //   2. A matching `visits` row must exist. The gate itself is enforced
    //      here rather than in the client, so the app cannot be patched to skip
    //      it. Note what this does and does not buy: the row is written by the
    //      client from GPS and nothing server-side re-checks the coordinates, so
    //      a determined user talking to Firestore directly can still forge the
    //      visit and then the review. It stops casual and drive-by review
    //      bombing, not a motivated attacker. Verifying location server-side is
    //      the fix if that ever becomes worth doing.
    //   3. The reviewer must be the signed-in user. Simulated personas
    //      (sim_*/persona_*) are never signed-in accounts, so the admin's
    //      "post as simulated user" path cannot reach this collection: crowd
    //      counts and chat are ambient and expire, a review is a durable claim
    //      about a real business and must come from a real person.
    // status is server-owned: a client may only ever write 'visible', so
    // nobody can un-hide a review an admin took down.
    match /reviews/{reviewId} {
      function ownsVisit() {
        return exists(/databases/$(database)/documents/visits/$(request.auth.uid + '_' + request.resource.data.visitDayKey + '_' + request.resource.data.venueId));
      }
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.auth.uid + '_' + request.resource.data.venueId
        && request.resource.data.status == 'visible'
        && ownsVisit();
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }
  }
}
